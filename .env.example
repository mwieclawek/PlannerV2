# =============================================================================
# PlannerV2 Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" in deployed environments. In production the backend REFUSES
# to start with a missing / placeholder / short (<32 chars) JWT_SECRET_KEY.
APP_ENV=development

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED. JWT signing key (>= 32 chars). Generate with: openssl rand -hex 32
# The backend refuses to boot when this is missing. Never reuse the value below.
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# REQUIRED at startup. PIN for manager authorization flows.
# Use a long random value: openssl rand -hex 8
MANAGER_REGISTRATION_PIN=change-me-in-production

# Fernet key used to encrypt stored Google OAuth tokens at rest.
# If unset, tokens are stored in PLAINTEXT (a warning is logged at startup).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Access token lifetime in minutes (default: 60)
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token lifetime in days (default: 7)
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend (use https:// in production)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development / CI)
DATABASE_URL=sqlite:///./planner.db

# PostgreSQL (production) — uncomment and fill in:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/planner

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# OAuth 2.0 Web client from Google Cloud Console (Calendar API enabled).
# The client must request offline access (access_type=offline, prompt=consent) so that
# Google returns a refresh_token; otherwise calendar sync stops ~1h after linking.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "postmessage" is correct for the Flutter/Google Sign-In server-auth-code flow.
GOOGLE_REDIRECT_URI=postmessage

# ── Push notifications (Firebase Cloud Messaging) ─────────────────────────────
# Path to the Firebase service-account JSON. If unset, pushes are only logged (mock).
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# ── Bug reports ───────────────────────────────────────────────────────────────
# GitHub token with "issues:write" on the repository. If unset, /api/bug-report returns 503.
# GITHUB_TOKEN=
